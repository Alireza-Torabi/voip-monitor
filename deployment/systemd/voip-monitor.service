[Unit]
Description=VoIP Monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=voip-monitor
Group=voip-monitor
WorkingDirectory=/opt/voip-monitor
Environment=VOIP_MONITOR_ENV_FILE=/etc/voip-monitor/voip-monitor.env
Environment=VOIP_MONITOR_NODE_BIN=/opt/voip-monitor/runtime/node/bin/node
ExecStart=/opt/voip-monitor/scripts/run-production.sh run
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectProc=invisible
ProcSubset=pid
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
RemoveIPC=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
ReadWritePaths=/var/lib/voip-monitor
UMask=0077

[Install]
WantedBy=multi-user.target
