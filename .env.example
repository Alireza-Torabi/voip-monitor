# Public application defaults only. This file is not loaded automatically.
# Never place PBX credentials here.
APP_ENV=production
APP_HOST=127.0.0.1
APP_PORT=3000
APP_LOG_LEVEL=info
DATA_PATH=/data
# Optional absolute runtime paths. Keep the secret directory outside Git and image builds:
# APP_SECRET_DIR=/data/secrets
# APP_DATABASE_PATH=/data/monitor.sqlite3
