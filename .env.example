# Public application defaults only. This file is not loaded automatically.
# Never place PBX credentials, bootstrap tokens, passwords, or session tokens here.
APP_ENV=production
APP_HOST=127.0.0.1
APP_PORT=3000
APP_LOG_LEVEL=info
# Disabled by default. plain_tcp requires an explicitly trusted/protected PBX network path.
APP_PBX_NETWORK_MODE=disabled
DATA_PATH=/data
# Optional absolute runtime paths. Keep the secret directory outside Git and image builds:
# APP_SECRET_DIR=/data/secrets
# APP_DATABASE_PATH=/data/monitor.sqlite3
